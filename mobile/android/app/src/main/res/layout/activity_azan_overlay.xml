<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06140E">

    <ImageView
        android:id="@+id/azan_wall_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/wall_makkah" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_azan_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="52dp"
        android:paddingEnd="24dp"
        android:paddingBottom="44dp">

        <!-- App Logo Header -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_notif_app_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="أذكار"
                android:textColor="#F3F4F6"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Prayer Details -->
        <TextView
            android:id="@+id/azan_badge_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.04"
            android:text="حان الآن موعد الأذان"
            android:textColor="#D4AF37"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/azan_prayer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="صلاة الفجر"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/azan_prayer_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="5:06 ص"
            android:textColor="#E5E7EB"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/azan_city_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="القاهرة (مصر)"
            android:textColor="#B8C4BE"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/azan_dhikr_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="حيّ على الصلاة • حيّ على الفلاح"
            android:textColor="#9DEFE3"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.2" />

        <!-- Action Buttons Row: Silent | Qibla | Cancel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layoutDirection="ltr"
            android:orientation="horizontal">

            <!-- Silent / Mute Button -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/azan_btn_silent"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_azan_circle_btn"
                    android:contentDescription="كتم الصوت"
                    android:padding="17dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_azan_silent" />

                <TextView
                    android:id="@+id/azan_lbl_silent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="كتم الصوت"
                    android:textColor="#E5E7EB"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Qibla Button -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/azan_btn_qibla"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/bg_azan_qibla_btn"
                    android:contentDescription="اتجاه القبلة"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_azan_qibla" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="اتجاه القبلة"
                    android:textColor="#F3F4F6"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Cancel / Dismiss Button -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/azan_btn_cancel"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_azan_cancel_btn"
                    android:contentDescription="إغلاق"
                    android:padding="17dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_azan_cancel" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="إغلاق"
                    android:textColor="#FCA5A5"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
